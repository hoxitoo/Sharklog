{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharkLog",
  "version": "0.1.0",
  "identifier": "com.sharklog.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SharkLog",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRjUzNUNDM0QzNDU0ODIKUldTQ1ZEUTl6RFgxWWtOOGt1a0VUZms4QXVHOW5RNTdjU1JUNU9LY2t5bk9ob1JmOVp5YnFHSFoK",
      "endpoints": [
        "https://github.com/hoxitoo/sharklog/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
